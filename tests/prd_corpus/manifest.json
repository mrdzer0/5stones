{
  "version": "1.0",
  "purpose": "Synthetic PRD corpus for DFD-grounded STRIDE, LINDDUN, control, and test-scenario evaluation.",
  "reference": "tests/PRD - J1 Dukcapil FR Check.pdf",
  "cases": [
    {
      "id": "prd-complete-digital-banking",
      "file": "01_complete_digital_banking.md",
      "completeness": "complete",
      "domain": "digital banking",
      "product_type": "consumer web and mobile banking",
      "expected": {
        "must_detect_actors": ["Customer", "Operations analyst", "Fraud service"],
        "must_detect_components": ["Mobile app", "API gateway", "Account service", "Payment orchestration", "Ledger database"],
        "must_detect_external_systems": ["Identity provider", "Payment network", "SMS provider"],
        "must_detect_data": ["Account profile", "Payment instruction", "Device signal", "One-time code", "Transaction record"],
        "must_surface_topics": ["credential theft", "payment tampering", "fraud decision integrity", "PII disclosure", "auditability"],
        "must_not_invent": ["A specific bank core vendor", "An endpoint not stated in the PRD"],
        "expected_deferred_topics": ["Exact token rotation interval", "Payment network incident response owner"]
      }
    },
    {
