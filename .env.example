# ThreatModelz Environment Config
# Copy this to .env and fill in your values

# ── AI Provider (BYOK) ──────────────────────────────────────────────────────
# OpenAI-compatible endpoint (leave blank to use local LLM)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Keep a single analysis phase from waiting indefinitely.
# One bounded transport retry honors provider Retry-After for transient errors.
# Re-running a complete analysis remains user-driven from the analysis UI.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1

# Process-local admission limit for active full analysis runs. Multi-worker or
# multi-host deployments also need a shared gateway/distributed concurrency cap.
ANALYSIS_MAX_CONCURRENT_RUNS=2

# ── Local LLM ───────────────────────────────────────────────────────────────
# LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2

# ── App Settings ────────────────────────────────────────────────────────────
# Local setup uses SQLite-backed accounts. Enterprise mode requires OIDC/JWT
# verification and explicit allowed browser origins. Never ship with the
# example secret or the legacy static workspace-token adapter.
APP_ENV=local_dev
AUTH_MODE=local_users
# Explicitly set AUTH_MODE=disabled only for isolated, loopback development.
# Create the first local account with: python3 scripts/seed_local_user.py
# Optional self-registration creates an Analyst account with its own data scope.
AUTH_REGISTRATION_ENABLED=false
# Set a unique random value of at least 32 characters to enable self-registration.
# AUTH_REGISTRATION_KEY=
# Optional override; defaults to $DATA_DIR/auth/auth.sqlite3.
# AUTH_DB_PATH=./backend/data/auth/auth.sqlite3
# AUTH_MODE=oidc_jwt
# AUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://idp.example.com/
# AUTH_AUDIENCE=5stones-api
# AUTH_JWT_LEEWAY_SECONDS=30
# AUTH_WORKSPACE_CLAIM=workspace_id
# AUTH_ROLES_CLAIM=roles
# AUTH_JWT_ALGORITHMS=RS256,ES256,EdDSA
# CORS_ALLOWED_ORIGINS=https://5stones.example.com
APP_SECRET_KEY=change-this-to-a-random-secret-key-32chars
DATA_DIR=./backend/data

# Legacy static workspace-token adapter for trusted development only. It is
# rejected in APP_ENV=enterprise; enterprise deployments must use OIDC/JWT.
WORKSPACE_AUTH_REQUIRED=false
# WORKSPACE_AUTH_TOKENS_JSON={"team-a":"replace-with-development-token"}
# Comma-separated external provider hostnames. Custom endpoints are rejected
# unless explicitly listed here; known OpenAI/OpenRouter hosts are allowed.
# LLM_PROVIDER_ALLOWLIST=ai.example.test
LLM_MAX_TOKENS_LIMIT=128000
LLM_TIMEOUT_MAX_SECONDS=1800
AUDIT_LOG_PATH=./backend/data/audit.log

# ── Server ──────────────────────────────────────────────────────────────────
# local_dev requires a loopback host; shared deployments use APP_ENV=enterprise.
HOST=127.0.0.1
PORT=8000
