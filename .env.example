# ThreatModelz Environment Config
# Copy this to .env and fill in your values

# ── AI Provider (BYOK) ──────────────────────────────────────────────────────
# OpenAI-compatible endpoint (leave blank to use local LLM)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Keep a single analysis phase from waiting indefinitely.
# Retries are user-driven from the analysis UI so progress remains transparent.
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0

# ── Local LLM ───────────────────────────────────────────────────────────────
# LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2

# ── App Settings ────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-this-to-a-random-secret-key-32chars
DATA_DIR=./backend/data

# Optional workspace isolation gate for project-scoped APIs. Keep disabled for
# the local single-user MVP. When enabled, configure a JSON map of workspace
# IDs to bearer tokens (use a secret manager outside development).
WORKSPACE_AUTH_REQUIRED=false
# WORKSPACE_AUTH_TOKENS_JSON={"team-a":"replace-with-development-token"}
# Comma-separated external provider hostnames. Custom endpoints are rejected
# unless explicitly listed here; known OpenAI/OpenRouter hosts are allowed.
# LLM_PROVIDER_ALLOWLIST=ai.example.test
LLM_MAX_TOKENS_LIMIT=128000
LLM_TIMEOUT_MAX_SECONDS=1800
AUDIT_LOG_PATH=./backend/data/audit.log

# ── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
